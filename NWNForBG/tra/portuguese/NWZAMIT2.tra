@0 = ~Agora que estamos a sós, não seja tímido. Apenas siga minhas ordens e tenho certeza de que será um homem feliz pela manhã!~ [NWZAM065]
@1 = ~Acho que não. Vim pegar a gema mágica que me disseram que você carrega. Entregue-a.~ 
@2 = ~O quê! Isso foi apenas um truque para me separar dos meus guardas! Não posso acreditar que estou à mercê de um homem!~
@3 = ~Ladrões e saqueadores! Como ousam me roubar minhas coisas!~ [ZAMIT062]
@4 = ~Chega! Eu desisto!~ [NWZAM067]
@5 = ~Embora me envergonhe admitir, estou derrotada.~ [NWZAM068]
@6 = ~Vim pela gema mágica que você possui.~
@7 = ~Não estou satisfeita com sua derrota. É sua vida que quero!~
@8 = ~Gema? Não tenho nenhuma gema! Do que você está falando?~
@9 = ~Eu sei que você tem a gema. A fonte estava muito certa.~
@10 = ~Você está livre para ir. Vou encontrar o que procuro no seu quarto.~
@11 = ~Então por que você está tão bem guardada e o que há naquele baú com ferragens?~
@12 = ~Chega disso! Morra!~
@13 = ~Você está levando a gema!? A vergonha! Fui enganada e derrotada por algum aventureiro insignificante! Como vou encarar minhas mulheres agora? A vergonha é demais! Muito bem! Pegue a gema! Está neste baú!~
@14 = ~Morro com uma lâmina na mão!~
@15 = ~Sua fonte estava mentindo! Sou apenas uma mulher simples e não tenho riquezas, muito menos gemas mágicas.~
@16 = ~Chega de mentiras. Apenas me diga onde está a gema.~
@17 = ~Sem a gema, você é inútil. Terei que matá-la agora!~
@18 = ~Você está levando a gema!? A vergonha! Fui enganada e derrotada por algum aventureiro insignificante! Como vou encarar minhas mulheres agora? A vergonha é demais!~
@19 = ~Muito bem! Pegue a gema! Está neste baú! A vergonha! Fui enganada e derrotada por algum aventureiro insignificante! Como vou encarar minhas mulheres agora? A vergonha é demais!~
@20 = ~Não me mate!! Apenas pegue a gema! Está neste baú! Por favor, apenas me deixe ir agora! A vergonha da derrota me arruinará aos olhos das minhas mulheres, de qualquer forma! Estou acabada!~
@21 = ~Você pode ir.~
@22 = ~Estou indo embora e vocês não terão mais meu dinheiro.~ [NWZAM052]
@23 = ~Não estou de bom humor para conversa agora. Talvez mais tarde.~ [NWZAM050]
