@0 = ~Você é poderoso para um escravo <RACE>. Você matou Maugrim, o profeta que anunciou a minha vinda.~ [NWMORA64]
@1 = ~Você derrotou Aribeth, a campeã que escolhi entre as raças escravas. Você massacrou muitos dos meus guerreiros e sacerdotes.~ [NWMORA65]
@2 = ~Mas agora você enfrenta Morag, Rainha dos Antigos, Alta Sacerdotisa dos Criadores! Ajoelhe-se, escravo, e eu pouparei sua vida!~ [NWMORA66]
@3 = ~Seu tempo acabou, Morag. Os Antigos não voltarão a se erguer!~
@4 = ~Eu não me ajoelho diante de ninguém, Morag!~
@5 = ~Hora de morrer, Morag!~
@6 = ~Eu arrancarei sua carne e me banquetearei com a sua alma!~ [NWMORA68]
