@0 = ~Fome. Comida. Comida? Fome.~
@1 = ~Quem é você? O que está fazendo aqui?~
@2 = ~Prepare-se para morrer, verme!~
@3 = ~Quero lhe fazer algumas perguntas.~
@4 = ~Vou indo agora.~
@5 = ~Comida? Me alimente. Fome. Comida?~
@6 = ~Você só pensa numa coisa só, hein.~
@7 = ~Nada inteligente para um dragão, não é?~
@8 = ~Tudo bem, eu vou te alimentar. Onde está a sua comida?~
@9 = ~Eu devia era te matar e acabar com o seu sofrimento.~
@10 = ~Fome. Comida. Fome.~
@11 = ~Fome! Comida! Comida! Comida!~
@12 = ~Comida? Comida? Fome. Comida?~
@13 = ~Obviamente tem algo errado com você. Vou indo agora.~
@14 = ~Você é o dragão mais estúpido que eu já conheci! Estou caindo fora daqui!~