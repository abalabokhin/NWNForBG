@0 = ~Qarth suclasa turth?~
@1 = ~O que você está dizendo?~
@2 = ~Adeus.~
@3 = ~Sou o guardião do segundo selo. Ninguém pode passar. Você deve dizer a senha na língua dos Mestres.~
@4 = ~Eu preciso atravessar o segundo selo.~
@5 = ~Ninguém pode passar. Você deve dizer a senha na língua dos Mestres.~
@6 = ~Eu sou um dos Mestres. Deixe-me passar.~
@7 = ~Você não fala a língua dos Mestres. Você não pode passar.~
@8 = ~Mas fui enviado pelos Mestres. Estou em uma missão importante e preciso passar.~
@9 = ~Você não diz a senha dos Mestres. Você não pode passar.~
@10 = ~Onde posso encontrar a senha?~
@11 = ~Não responderei mais perguntas, escravo.~
@12 = ~Você não pode passar, escravo. Deve dizer a senha na língua dos Mestres.~
@13 = ~Thurth mog lama gat rag.~
@14 = ~Você fala a língua dos Mestres. Pode passar.~
@15 = ~A porta está aberta. Não preciso mais de você.~
