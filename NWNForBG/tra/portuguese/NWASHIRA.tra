@0 = ~Vejo ao olhar para você que não é do meu mundo de Azallah, mas ainda assim agradeço por sua ajuda.~ [ASHIR602]
@1 = ~Se você não tivesse intervindo, temo que eu teria sucumbido aos saqueadores escamados. Meu nome é Asheera, da Ordem Resplandecente, da cidade de Sahaladar.~ [ASHIR603]
@2 = ~Exceto pelas roupas, você se parece com Aribeth de Tylmarande!~
@3 = ~Minhas vestes são as de meu povo, embora talvez pareçam tão estranhas a você quanto as suas me parecem a mim.~ [ASHIR604]
@4 = ~Quanto ao nome Aribeth, não tenho conhecimento algum. Ela era uma companheira sua?~ [ASHIR605]
@5 = ~Ela foi uma heroína de nosso povo, certa vez. Até cair e nos trair para Morag.~
@6 = ~Ela é uma vil traidora a serviço de Morag!~
@7 = ~Morag? Esse nome me é conhecido — a rainha dos saqueadores escamados! Seu rosto assombra meus sonhos, sua voz sibilante sussurrando promessas de poder para me tentar a trair meu povo.~ [ASHIR606]
@8 = ~Mas eu sou da Ordem Resplandecente, juramentada a servir Sahaladar, a maior das cidades flutuantes de Azallah. Jurei destruir Morag e salvar meu povo.~ [ASHIR607]
@9 = ~Você me lembra Aribeth.~
@10 = ~Você fala de muitos lugares que nunca ouvi mencionar.~
@11 = ~Como você chegou aqui?~
@12 = ~Por que você quer matar Morag?~
@13 = ~Já ouvi essa história antes. Vou matá-la agora, antes que me traia.~
@14 = ~Adeus.~
@15 = ~Eu não sou Aribeth sou Asheera. E, ainda assim, há muitos mundos e planos de existência reunidos neste lugar estranho.~ [ASHIR623]
@16 = ~Todos que vivem entre as ilhas de Azallah conhecem Sahaladar, a cidade beijada pela espuma acima do mar. As torres de meu lar cintilam e reluzem como coral sob as águas azul-celeste.~ [ASHIR608]
@17 = ~Após muita busca, os magos de Sahaladar descobriram um portal em meu mundo um portão que leva a este pseudoplano onde muitos universos convergem.~ [ASHIR615]
@18 = ~Os Antigos buscam retornar ao mundo de seu nascimento, mas para isso precisam de escravos e recursos reunidos de outros mundos mais fracos.~ [ASHIR617]
@19 = ~Asheera, guardiã de Sahaladar, não é traidora! Por todas as ilhas de Azallah minha palavra é meu juramento, e ninguém questiona minha honra!~ [ASHIR627]
@20 = ~Poupe-me. Não confio em você e você deve morrer!~
@21 = ~Espere — antes de partir, há algo que preciso lhe dizer. Por favor, você deve ouvir — meu tempo está se esgotando!~
@22 = ~O que é que você precisa me dizer?~
@23 = ~Esqueça. Não vou ouvir você!~
@24 = ~Pode ser que aquela que você chama de Aribeth seja minha contraparte em seu mundo — ou que eu seja a contraparte dela, se preferir. Talvez seja por isso que fomos trazidas aqui.~ [ASHIR624]
@25 = ~O que você quer dizer com isso?~
@26 = ~Aribeth me traiu — não posso correr o mesmo risco com você. Você deve morrer!~
@27 = ~Nas profundezas sob nossa ilha flutuante fica a maravilhosa capital dos Kilm, os respiradores aquáticos com quem compartilhamos nosso mundo em paz.~ [ASHIR609]
@28 = ~Seis foram escolhidos para atravessar o portal, embora soubéssemos que não poderíamos retornar. Meus companheiros há muito já caíram.~ [ASHIR616]
@29 = ~Morag soltou os saqueadores escamados sobre meu mundo natal. Azallah jamais havia enfrentado um inimigo tão terrível; sua crueldade selvagem era tão alienígena quanto sua aparência.~ [ASHIR618]
@30 = ~Maldita seja sua desconfiança! Eu poderia tê-lo ajudado a derrotar a Rainha Escamada, mas agora é tarde demais! O feitiço que me prende aqui está se desfazendo, e meu espírito não pode permanecer neste plano.~
@31 = ~A Rainha dos saqueadores escamados ainda vive, mas o feitiço que me trouxe a este lugar está enfraquecendo. Em breve ele falhará e meu espírito será arrancado deste plano de volta ao meu mundo natal, Azallah.~
@32 = ~Jamais alcançarei o santuário interior de Morag, e o artefato mágico forjado por meu povo para matar a Rainha será desperdiçado — a menos que eu o entregue a você.~
@33 = ~Dê-me o artefato. Eu o usarei para ajudar a derrotar Morag.~
@34 = ~O que esse artefato faz?~
@35 = ~Você diz que Aribeth traiu sua fé, que se perdeu para o mal de Morag. Talvez tenhamos nos encontrado para que eu possa ajudá-lo a vingar sua queda.~ [ASHIR625]
@36 = ~Quando ingressei na Ordem Resplandecente, jurei defender Sahaladar. Mas agora desonrei meus votos e falhei em meu dever juramentado.~
@37 = ~Sou a única que resta entre os campeões de meu povo, mas, como meus companheiros caídos, também falhei.~ [ASHIR616]
@38 = ~Falhou? Como assim você falhou?~
@39 = ~Os saqueadores escamados despojaram meu mundo indefeso de seus tesouros mágicos, e muitos de meu povo foram sacrificados em rituais bizarros para alimentar o poder de sua rainha.~ [ASHIR619]
@40 = ~E você veio em busca de vingança.~
@41 = ~Meu tempo aqui está se esgotando. Rápido — pegue este amuleto! Ele o ajudará a se proteger contra Morag e seu povo.~
@42 = ~Sou uma verdadeira cavaleira da Ordem Resplandecente de Sahaladar. Talvez eu tenha sido trazida aqui de Azallah para redimir a memória de Aribeth, para que sua alma seja purificada de seus pecados por meio de minhas ações.~ [ASHIR626]
@43 = ~A Rainha dos saqueadores escamados ainda vive, mas o feitiço que me trouxe a este lugar está enfraquecendo. Em breve ele falhará e meu espírito será arrancado deste plano de volta ao meu mundo natal, Azallah. Jamais alcançarei o santuário interior de Morag, e o artefato mágico forjado por meu povo para matar a Rainha será desperdiçado — a menos que eu o entregue a você.~
@44 = ~Vingança é apenas um dos motivos pelos quais estou aqui. Meu mundo era pacífico e vulnerável. Foi por isso que estivemos entre os primeiros a sofrer.~ [ASHIR620]
@45 = ~Meu tempo aqui está se esgotando; talvez eu possa ajudá-lo a fazer o que não pude. Mas, se você não me ajudar, então minha missão terá fracassado.~
@46 = ~Mas, à medida que o poder de Morag cresce, mais dos Antigos despertam. Em breve um exército conquistador de seus lacaios jorrará para retomar seu mundo natal.~ [ASHIR621]
@47 = ~Então Morag escravizará mundo após mundo, e todos conhecerão o sofrimento de Azallah. Vim aqui para impedir isso, mas falhei.~ [ASHIR622]
@48 = ~Que a espuma do oceano borbulhe vermelha com o sangue dos saqueadores escamados!~ [ASHIR630]
