@0 = ~Minha mamãe diz que há criminosos soltos por toda parte.~
@1 = ~Minha mamãe diz que todos estão mortos em Neverwinter.~
@2 = ~Você é engraçado!~
@3 = ~Meninas são melhores que me-meninos!~
@4 = ~O jogo de lobisomem do meu irmão é tão estúpido.~
@5 = ~Os meninos estavam jogando 'Soldados e Ladrões!' Jimmy estava jogando como Stirge, o Bebê Ladrão, mas não conseguiu pensar em nenhuma charada boa!~
@6 = ~Fique longe de mim, você é estranho.~
@7 = ~Os meninos estavam jogando 'Soldados e Ladrões!' Eu os vi!~
