@0 = ~Você não pode passar.~
@1 = ~Por quê?~
@2 = ~Não viemos até aqui para sermos barrados por uma porta falante.~
@3 = ~Quem é você?~
@4 = ~Somente aqueles com quatro bugigangas de cristal podem passar por esta porta.~
@5 = ~O quê? Isso é ridículo.~
@6 = ~Estou farto desses enigmas. Abra agora, ou você vai virar um monte de entulho falante.~
@7 = ~Desisto. Não quero mais esses enigmas. Leve-me de volta à taverna.~
@8 = ~Tudo bem. Adeus.~
@9 = ~Tem certeza? Você não pode voltar, não pode voltar.~
@10 = ~Então, diga-nos de novo: quem vai passar?~
@11 = ~Está decidido, vou voltar para a taverna.~
@12 = ~Eu só estava passando. Até mais.~
@13 = ~Que assim seja.~
@14 = ~Você pode passar.~
