@0 = ~Nós se rende! Não machuca. Nós não quer morrer tanto assim!~
@1 = ~Agora responde minhas perguntas.~
@2 = ~Eu aceito rendição, se outros goblins parar de lutar comigo.~
@3 = ~Tô ouvindo. O que eu ganho se deixar você viver?~
@4 = ~Na verdade, eu gosto de matar goblins. Sem acordo.~
@5 = ~Tá bom, você vive por enquanto.~
@6 = ~O que você pergunta pra nós goblins, hein? Nós não sabe tanta coisa assim como você <RACE> acha que sabe. Eh... qual pergunta, hein?~
@7 = ~Fala dessas cavernas.~
@8 = ~Onde tá seu líder? Quero falar com ele.~
@9 = ~Você quer que nós faça todos goblins ficar em paz com você? Tá bom, nós faz isso. Sim, nós fala, espalha palavra. Você deixa nós ir, né?~
@10 = ~Acordo fechado.~
@11 = ~O que você quer dizer? Você quer tesouro talvez? Eu tem ouro. Eu dá ouro se você para de lutar com nós?~
@12 = ~Os outros goblins vão parar de lutar se eu concordar?~
@13 = ~Aaarrrggghhh! Nós ainda tá lutando com <RACE>! Mata!~
@14 = ~Nós continua vivos! Nós ainda respira! Nós corre embora agora!~
@15 = ~Nós tá em guerra com orcs e bugbears. Um dia nós vivia aqui sozinho, agora tem outros morando com nós, tudo por causa do mestre.~
@16 = ~Você quer falar com nosso chefe, né? Tá bom, eu fala. Ele tá bem aqui.~
@17 = ~Nós continua vivos! Nós ainda respira! Nós corre embora agora! E nós fala pros outros goblins não lutar com você, não! Nós é bom. Você vê!~
@18 = ~Nós foi mandado não brigar com você. Então eu não fala, não. Você fala com o chefe.~
@19 = ~Eu não mata você agora, <RACE> amigo. Fala com o chefe.~
