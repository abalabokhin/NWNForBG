@0 = ~Saudações, <CHARNAME>. Os preparativos para o ritual estão bem adiantados. Se tudo correr bem, teremos a cura em apenas alguns momentos.~ [NWARI170]
@1 = ~Devo dizer, sabia que você seria fundamental para esta causa. Sempre apresentou a aparência confiante de um(a) <MANWOMAN> de ação.~ [NWARI171]
@2 = ~Há algo que eu deva fazer? O que acontece agora?~
@3 = ~Fico feliz que essa confusão tenha acabado. Quando serei recompensado(a)?~
@4 = ~Não precisa se preocupar com nada. Seus esforços nos trouxeram até aqui, e agora o ritual cuidará do resto. Depois disso, cuidarei de sua recompensa.~ [NWARI172]
@5 = ~Tanta impaciência não lhe cai bem. Verá os frutos de seu trabalho quando o ritual estiver completo.~ [NWARI213]
@6 = ~Por enquanto, pode deixar o que deve ser feito conosco. Você ganhou o direito de testemunhar, porém, e tenho certeza de que os outros diriam o mesmo.~ [NWARI173]
@7 = ~Fenthik disse que revelou a Desther o segredo dos feitiços defensivos do castelo.~ 
@8 = ~Tenho perguntas sobre o ritual.~
@9 = ~As coisas voltarão ao normal agora?~
@10 = ~Tenho perguntas sobre a região.~
@11 = ~Adeus.~
@12 = ~Estou ciente. Nossos guardas aqui são muito atentos. Haverá consequências, mas não agora. Há coisas mais importantes a tratar.~ [NWARI174]
@13 = ~Tentarei explicar. Há algo específico que deseja saber?~ [NWARI177]
@14 = ~O que envolve o ritual?~
@15 = ~Que forma terá a cura?~
@16 = ~Bem, uma vez que tivermos a cura em mãos, determinaremos a melhor forma de levá-la ao maior número de pessoas o quanto antes.~ [NWARI186]
@17 = ~Tenho certeza de que eles podem se expressar por si mesmos, mas responderei a qualquer pergunta que você tiver.~ [NWARI194]
@18 = ~Como está Lord Nasher?~
@19 = ~Sua opinião sobre Desther mudou de alguma forma?~
@20 = ~Sua relação com Fenthick melhorará agora?~
@21 = ~Vamos voltar às minhas outras perguntas.~
@22 = ~Sim, acho que já passou a hora de falar. Você conversou com todos e estamos prontos. O ritual começará agora.~ [NWARI203]
@23 = ~Sim, adeus por enquanto. Há muito que devo fazer para preparar o lançamento. As invocações são muito complexas.~ [NWARI204]
@24 = ~Vamos observar Desther cuidadosamente, mas ele é necessário para as invocações e não arriscarei sua natureza temperamental e estragar nossa chance de uma cura.~ [NWARI175]
@25 = ~Bem, vários de nossos sacerdotes de Tyr já começaram os preparativos. Sua meditação permitirá que os diferentes componentes sejam combinados suavemente.~ [NWARI178]
@26 = ~Preparamos um pequeno recipiente. A mistura em si será bastante sem graça de se olhar, apesar de sua importância.~ [NWARI183]
@27 = ~Levará tempo, então trataremos primeiro os casos mais graves de praga, independentemente da posição social. Espero que... bem... nos preocuparemos com outras coisas depois.~ [NWARI187]
@28 = ~O que a preocupa, Aribeth? Conte-me.~
@29 = ~Sou um(a) elfo(a) como você. Diga-me qual é sua preocupação.~ 
@30 = ~Você realmente deveria perguntar a ele isso. Ele detesta ser visto como fraco e prefere ser envolvido em qualquer discussão sobre sua saúde.~ [NWARI195]
@31 = ~Eu perguntaria se sua opinião sobre ele foi afetada. Foram seus esforços que nos trouxeram até aqui. Suas ações parecem baseadas em seus resultados.~ [NWARI196]
@32 = ~Este período foi... difícil, e nossas diferenças de opinião o tornaram ainda mais. Fenthick e eu pouco conversamos além da praga.~ [NWARI199]
@33 = ~Como desejar. O que quer que eu diga?~ [NWARI184]
@34 = ~Você deve conversar com os outros. Sem dúvida, cada um terá seus próprios sentimentos sobre como nossa situação mudou.~ [NWARI211]
@35 = ~Fenthick corre riscos insensatos, mas não permitirei que nenhum dano ocorra. A praga não dividirá os vivos.~ [NWARI176]
@36 = ~Desther, Fenthick e eu começaremos as principais invocações assim que estivermos preparados. Se tudo correr bem, teremos a cura em poucos momentos.~ [NWARI179]
@37 = ~Estamos muito perto do nosso objetivo, mas... não consigo deixar de me preocupar com os efeitos da praga. Há uma grande cicatriz sobre Neverwinter.~ [NWARI188]
@38 = ~Não é realmente apropriado falar dessas coisas agora. Não é importante. Lidaremos com tudo à medida que surgir.~ [NWARI191]
@39 = ~Você será capaz de entender, me pergunto? Uma grande cicatriz foi marcada no coração de Neverwinter. Talvez você também a veja?~ [NWARI193]
@40 = ~Enquanto você buscava, seus Helmitas abençoavam. Enquanto você lutava, seus Helmitas abençoavam. O conforto que trouxe será pequeno comparado à cura que você proporcionou.~ [NWARI197]
@41 = ~Entendo por que deposita tanta esperança em Desther, mas eu não podia. Sei o poder da fé, mas você precisa respaldá-la com ação.~ [NWARI200]
@42 = ~Não é cedo demais para Lord Nasher; a praga o enfraqueceu consideravelmente. Acho que ele quase considera um insulto pessoal ser visto assim.~ [NWARI180]
@43 = ~Imagino que ele esteja mais acostumado a um combate direto.~
@44 = ~Já percebo a desconfiança. O humor da cidade mudou. Quando tudo terminar, o povo quererá alguém para culpar, e não sei se encontraremos.~ [NWARI189]
@45 = ~Agora, há mais alguma coisa? Você deve falar com os outros se ainda não o fez. Eles também o parabenizariam.~ [NWARI192]
@46 = ~Claro, ele é necessário para o ritual final, então não posso dispensá-lo completamente. Fenthick também serve como seu defensor, então merece algum respeito.~ [NWARI198]
@47 = ~Sim, concordo. Ele é... arquetípico. Temos quase certeza de que a praga foi um ataque, mas ele não faz ideia de que tipo de vilão desceria tão baixo.~ [NWARI181]
@48 = ~(ahem) Não deveria divagar assim quando estamos tão perto da cura. Este é um dia feliz, e chegamos aqui graças a você.~ [NWARI190]
@49 = ~Olá novamente, <CHARNAME>. Tenho um momento para conversar, mas assim que terminar de falar com todos, podemos iniciar a cerimônia.~ [NWARI216]
@50 = ~Depressa, atravesse o portal enquanto ainda posso mantê-lo! Encontre a cura! Traga Desther e... e Fenthick também. Ele pode estar sob um feitiço ou... não sei.~ [NWARI217]
@51 = ~Pode imaginar? Devo desejar mal a Fenthick em vez de encarar a possibilidade de que... que ele pudesse ter conhecimento disso.~ [NWARI218]
@52 = ~Talvez as pessoas pensem que ele sabia. Ele sempre apoiou Desther.~ [NWARI219]
@53 = ~Fenthick seguiu Desther? Esperemos que tenha ido impedi-lo.~ 
@54 = ~Não diga tais coisas! Não pode ser! Ele se enganou! Foi enganado! Ele foi... Ele foi... maldito seja...~ [NWARI219]
@55 = ~O que ele estava pensando? Se ele teve alguma participação nisso... isso pouco importa agora... Ele parece ter fugido com Desther. O povo não aceitará essa ação!~ [NWARI232]
@56 = ~O povo não deixará passar. Negaram-lhes a cura e eles quererão vingança contra o traidor e quem o ajudou... Eu... não poderei protegê-lo... Eu não...~ [NWARI220]
@57 = ~Talvez... talvez entregar Desther alivie as coisas. Encontre-o vivo se puder. Encontre Fenthick e leve-o a... não sei... não sei o que ajudará agora.~ [NWARI221]
@58 = ~O que acontecerá com Fenthick?~ 
@59 = ~O que você vai fazer?~ 
@60 = ~Para onde vai este portal?~ 
@61 = ~Se Desther e seus Helmitas são falsos, onde estão os verdadeiros?~ 
@62 = ~Eu... não sei. As pessoas vão pensar que ele está aliado à maior ameaça que já conhecemos... Eu não sei...~ [NWARI222]
@63 = ~Eu... manterei o portal enquanto puder, mas pode demorar antes de enviarmos guardas. Você terá que ir sozinho(a).~ [NWARI225]
@64 = ~Não sei... é difícil dizer. Não consigo ver através da magia de Desther. Provavelmente leva para onde ele e seus falsos Helmitas originalmente vieram.~ [NWARI227]
@65 = ~Não sei. Talvez Desther os tenha matado. Parece impossível. Ele veio da Fortaleza de Helm... se aquele grande salão caiu... esta é uma tragédia ainda maior.~ [NWARI230]
@66 = ~Ele estava enganado... ele defendia um traidor. As pessoas não entenderão sua ingenuidade... sua confiança. Poderia culpá-las por encontrar um bode expiatório?~ [NWARI223]
@67 = ~Irei o mais rápido que puder. Talvez consiga alcançá-lo.~ 
@68 = ~Os guardas da cidade são necessários em outro lugar, então esta tarefa recai sobre você. Vá, antes que o portal caia!~ [NWARI224]
@69 = ~Também tentarei fazer isso soar melhor do que realmente é... Não posso esconder a confiança cega de Fenthick em Desther... mas se eu explicar no contexto... Talvez...~ [NWARI226]
@70 = ~Desther afirmou que veio da Fortaleza de Helm, no leste, mas não sei como isso poderia ser verdade. Eles não fariam parte de um plano assim.~ [NWARI228]
@71 = ~Esta é uma grande tarefa... parece que Desther fez tudo isso para promover a praga... mas por quê?! Tantos mortos... agora a Fortaleza?~ [NWARI231]
@72 = ~Para onde quer que o portal leve, tenho certeza de que será perigoso. Ele deve saber que enviaríamos alguém atrás dele. Tenha cuidado.~ [NWARI229]
@73 = ~Não há tempo! Você deve encontrar Desther! Posso manter o portal por agora, mas você deve se apressar! Se os encontrar a tempo, talvez...~ [NWARI233]
@74 = ~Talvez as ações de Fenthick sejam ignoradas... talvez ele seja perdoado antes que a cidade procure... vingança em vez de justiça...~ [NWARI234]