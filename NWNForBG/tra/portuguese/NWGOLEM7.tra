@0 = ~Qarth suclasa turth?~
@1 = ~O que você está dizendo?~
@2 = ~Adeus.~
@3 = ~Eu sou o guardião do primeiro selo. Ninguém pode passar.~
@4 = ~O que é o primeiro selo?~
@5 = ~Este lugar não é para você. Apenas os mestres podem entrar aqui.~ 
@6 = ~Preciso atravessar o portal.~
@7 = ~Ninguém pode passar.~
@8 = ~Aqui está o anel.~
@9 = ~Eu sou um dos Mestres. Deixe-me passar.~
@10 = ~Você não fala a língua dos Mestres. Você é uma das raças escravas. Não pode passar.~
@11 = ~Mas fui enviado pelos Mestres. Estou em uma missão importante e preciso passar.~
@12 = ~Você não possui o anel do criador. Escravos enviados pelos criadores sempre têm o anel de Gax.~
@13 = ~Onde posso conseguir esse anel?~
@14 = ~Não responderei mais perguntas, escravo.~
@15 = ~Você não pode passar, escravo.~ 
@16 = ~Você pode passar.~
@17 = ~Terminei com você.~
