@0 = ~Ouça minha voz através de seus mortos! Você pensou em me usar, em me sacrificar para um feitiço! Eu usei vocês para me libertar!~ [NWGULN50]
@1 = ~Vocês se juntarão à minha legião de mortos! Eu vi as visões! Os Escamados governarão aqui! Eu passarei por cima de tudo!~ [NWGULN51]
@2 = ~A praga enfraquece vocês, mas fortalece meu exército! É uma bênção! Um presente! Vocês não conseguem imaginar o presente!~ [NWGULN52]
@3 = ~Você não pode negar que as escamas irão governar! Vê o poder que me foi concedido?! É incrível, e vai além até mesmo de Merrshaulk!~ [NWGULN53]
@4 = ~Venha se quiser, mas você morrerá! As visões não podem mentir! Eu vejo a chegada do Olho! O Olho!~ [NWGULN54]
