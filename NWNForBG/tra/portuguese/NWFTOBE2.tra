// FTOBE2 translation file from BG1
@1 = ~Ahh! Com que direito você entra na minha casa?!~
@2 = ~Desculpe a intromissão, eu só estava me perguntando o que você estava fazendo.~
@3 = ~Poupe o fôlego, não quero lhe causar mal algum.~
@4 = ~Pelo direito da força! Sugiro que coopere enquanto eu me ajudo com seus objetos de valor.~
@5 = ~Minhas desculpas! Devo ter o endereço errado. Vou sair imediatamente.~
@6 = ~O que estou fazendo não é da sua conta! Saia já, antes que eu chame os guardas!~
@7 = ~Então deixe a mim e aos meus! Você não foi convidado à minha casa, então suma daqui!~
@8 = ~Não posso fazer nada para impedi-lo, mas posso chamar quem possa. Saia agora, ou a guarda dará fim em você.~
@9 = ~E é bom mesmo! Se meu marido o pegar aqui, com certeza será o seu fim!~
@10 = ~Sou apenas uma simples garota da cidade, e não acho que saiba de algo que seja útil a grandes aventureiros.~
@11 = ~Já disse antes. Não quero você aqui! Agora suma!~
@12 = ~Você já ultrapassou os limites da hospitalidade!~
