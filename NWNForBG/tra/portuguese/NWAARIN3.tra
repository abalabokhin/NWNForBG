@0 = ~Com licença, mas onde está <CHARNAME>? Só falarei com ele.~ 
@1 = ~Não perca a esperança, meu Senhor. Ainda temos as Palavras de Poder, afinal.~ [NWAAR471]
@2 = ~Talvez Haedraline nos revele seu segredo - se você a libertar das masmorras.~ [NWAAR472]
@3 = ~Haedraline nos contou sobre a porta secreta sob o Castelo de Never. Sem ela, nunca teríamos encontrado a Pedra da Fonte.~ [NWAAR473]
@4 = ~Talvez Haedraline fale com <CHARNAME>. Ela já conversou com <HIMHER> antes.~ [NWAAR474]
@5 = ~As ações dela não são sem motivo, Lord Nasher. Neverwinter virou as costas para ela quando executou seu amante, Fenthick.~ [NWAAR475]
@6 = ~Quando entrei a seu serviço, Lord Nasher, você perguntou se eu lhe serviria fielmente. Lembra-se do que eu disse?~ [NWAAR476]
@7 = ~Ainda estou ao seu lado, Lord Nasher. Mas Fenthick e Aribeth eram amantes. Aos olhos dela, você deu Fenthick como sacrifício para apaziguar a multidão indisciplinada.~ [NWAAR477]
@8 = ~Você deve falar com Lord Nasher primeiro, <CHARNAME>.~ [NWAAR570]
@9 = ~Depois de falar com ele, poderá voltar e falar comigo.~ [AARIN571]
@10 = ~Estes são realmente tempos sombrios, <CHARNAME> - embora não tão sombrios quanto Lord Nasher os pinta. O povo de Neverwinter é mais resiliente do que qualquer um de nós imagina.~ [NWAAR516]
@11 = ~Mas se Neverwinter for sobreviver, todos devemos fazer nossa parte. Meu lugar é aqui, ao lado de Lord Nasher. Devo supervisionar todos os aspectos da defesa da cidade.~ [NWAAR517]
@12 = ~E sua própria parte é algo que você conhece bem. Deve salvar Neverwinter mais uma vez - embora eu não possa dizer como. Talvez a criatura que Haedraline conhece saiba algo.~ [NWAAR518]
@13 = ~Tenho a quarta Palavra de Poder.~
@14 = ~Maugrim está morto.~
@15 = ~Haedraline me contou algumas informações que acho que você deveria ouvir.~
@16 = ~Quero lhe fazer algumas perguntas.~
@17 = ~Queria saber como você está se mantendo, Aarin.~
@18 = ~Preciso ir embora.~
@19 = ~Alguns de meus agentes relataram que você recuperou a quarta Palavra de Poder, <CHARNAME>. Não fiquei surpreso, dado todos os seus feitos anteriores.~ [NWAAR490]
@20 = ~Agora que temos todas as quatro Palavras, talvez possamos desbloquear seu poder, Lord Nasher.~ [NWAAR491]
@21 = ~Não - mas suspeito que Haedraline entende seus mistérios. Talvez esteja disposta a compartilhar seus segredos com <CHARNAME>.~ [NWAAR492]
@22 = ~Receio que Lord Nasher esteja certo - você deve falar com Haedraline sobre isso. Precisa de mais alguma coisa, <CHARNAME>?~ [NWAAR493]
@23 = ~Sim, ouvi que ele encontrou um fim violentamente adequado. Ainda assim, o espírito inimigo não está quebrado. Outros assumem a liderança do exército de Luskan.~ [NWAAR494]
@24 = ~Temo que Haedraline não confie em nós. Compreensível, considerando a recepção que recebeu ao chegar. Você é o único com quem ela está disposta a falar.~ [NWAAR518]
@25 = ~Conheci todos os segredos desta cidade uma vez, mas são tempos turbulentos e até eu me vejo tropeçando no escuro. Ainda assim, direi tudo o que puder.~ [NWAAR519]
@26 = ~O que você pode me dizer sobre Haedraline?~
@27 = ~O que você pode me dizer sobre as Palavras de Poder?~
@28 = ~O que você pode me dizer sobre a Pedra da Fonte?~
@29 = ~Quais são as últimas notícias das linhas de batalha?~
@30 = ~Quero lhe perguntar sobre Aribeth.~
@31 = ~Estou interessado em saber mais sobre Lord Nasher.~
@32 = ~O quanto se pode esperar, meu amor. Estes são tempos difíceis para todos os envolvidos.~ [NWAAR512]
@33 = ~Você deveria falar com Haedraline antes de ir, <CHARNAME>. Talvez ela lhe diga algo sobre a Pedra da Fonte ou as Palavras de Poder.~ [NWAAR567]
@34 = ~Sim, <CHARNAME> - ainda há muito a ser feito se Neverwinter for salvo.~ [NWAAR569]
@35 = ~Como temíamos, há um poder mais sombrio por trás dos invasores do que Maugrim. Tudo o que podemos fazer é resistir o quanto pudermos e rezar para que a ajuda chegue a tempo.~ [NWAAR495]
@36 = ~Talvez seja melhor manter os segredos dela. Se quiser compartilhar conosco, enviará mensagem a Lord Nasher ou a mim.~ [NWAAR498]
@37 = ~Isso é estranho para um mestre espião dizer.~
@38 = ~Você está certo, Aarin. De qualquer forma, não pode me ajudar com isso.~
@39 = ~Ela chegou aqui logo após a terceira Palavra de Poder ter sido entregue ao Castelo de Never. Lord Nasher suspeitou que fosse uma espiã e a prendeu nas masmorras.~ [NWAAR520]
@40 = ~Lord Nasher entregou-as ao Mestre Ford, chefe arqueólogo de Neverwinter. Ele acredita que há uma ligação entre as Palavras e a Pedra da Fonte.~ [NWAAR519]
@41 = ~Haedraline nos contou sobre a Pedra da Fonte e a porta secreta sob o Castelo de Never. Como mestre espião, envergonha-me admitir que nunca suspeitei de câmaras ocultas em nossas masmorras antes disso.~ [NWAAR531]
@42 = ~As coisas acalmaram desde o ataque inicial. Os defensores recuaram para o Núcleo da Cidade, mas não sei quanto tempo conseguiremos resistir.~ [NWAAR534]
@43 = ~Entendo sua preocupação por ela, <CHARNAME>, mas não sei o que lhe dizer. Seu destino ainda não foi decidido.~ [NWAAR555]
@44 = ~Dói-me falar dela. Houve um tempo em que a considerava uma campeã de Neverwinter e a chamava de 'amiga'.~ [NWAAR558]
@45 = ~Ele foi um grande aventureiro, sabia? Gostaria que você o tivesse conhecido então - um verdadeiro herói em toda sua magnífica glória.~ [NWAAR563]
@46 = ~Fico feliz que esteja ao meu lado nisso, <CHARNAME>. Mas se quisermos salvar Neverwinter, não podemos deixar nossos sentimentos nos distrair. Devemos permanecer focados na tarefa.~ [NWAAR509]
@47 = ~Meu instinto me diz que ela é a chave se Neverwinter for salvo - e aprendi a confiar em meus instintos.~ [NWAAR568]


@49 = ~Há mais alguma coisa que você precise, <CHARNAME>? Se não, devo voltar aos meus relatórios de reconhecimento.~ [NWAAR496]
@50 = ~Não sou apenas um mestre espião agora, <CHARNAME>. Sou responsável por coordenar toda a defesa de Neverwinter. Não arriscarei alienar um possível aliado em Haedraline.~ [NWAAR499]
@51 = ~Se tivéssemos pessoal suficiente, colocaria uma companhia inteira à sua disposição. Mas preciso de todos os homens nas linhas de batalha apenas para impedir que Luskan tome o Núcleo da Cidade.~ [NWAAR501]
@52 = ~Após a traição de Aribeth, ele se tornou excessivamente cauteloso, e temo que isso tenha feito Haedraline desconfiar de nós. Ela nos contou sobre a Pedra da Fonte sob o castelo, mas nada além disso.~ [NWAAR521]
@53 = ~Mas o Mestre Ford não conseguiu aprender nada mais sobre as Palavras de Poder ou a Pedra da Fonte, infelizmente.~ [NWAAR528]
@54 = ~Onde posso encontrar o Mestre Ford?~
@55 = ~Quando encontramos a Pedra, Lord Nasher colocou o Mestre Ford, principal especialista arqueológico de Neverwinter, responsável por estudá-la.~ [NWAAR532]
@56 = ~Estamos em grande desvantagem numérica, e Aribeth conhecia cada centímetro desta cidade. Todo o seu conhecimento está sendo usado contra nós agora.~ [NWAAR535]
@57 = ~E se eu pudesse matar Aribeth e Maugrim?~
@58 = ~A morte de Maugrim teve pouco efeito na batalha. Parece que ele não era a verdadeira força por trás de nosso inimigo.~ [NWAAR541]
@59 = ~O que quer dizer?~
@60 = ~Enquanto a guerra continuar, Lord Nasher manterá Aribeth viva para que ela continue fornecendo informações sobre as forças de Luskan.~ [NWAAR556]
@61 = ~A traição dela nos atingiu duramente, especialmente Lord Nasher. Ele não admite, mas imagino que a situação tenha se agravado pelo sentimento de culpa que ele sentiu pela execução de Fenthick.~ [NWAAR559]
@62 = ~Ele é um homem diferente agora. Ainda um bom homem, mas a burocracia e a responsabilidade da liderança pesam sobre ele. Tornou-se sombrio e sério.~ [NWAAR564]
@63 = ~Confio em você, <CHARNAME>, e suspeito que qualquer informação que Haedraline tenha compartilhado é algo que não posso ajudá-lo de qualquer forma.~ [NWAAR500]
@64 = ~Você terá que agir por conta própria com base nas informações de Haedraline, receio. Precisa de mais alguma coisa, <CHARNAME>?~ [NWAAR502]
@65 = ~Talvez você pudesse tentar falar com ela. Ela confia em você. E sinto que há algo importante que ela não nos contou sobre as Palavras de Poder e a Pedra da Fonte.~ [NWAAR522]
@66 = ~Onde posso encontrar Haedraline?~
@67 = ~Você pode libertar Haedraline da masmorra?~
@68 = ~Desde que desenterramos a Pedra sob o castelo, o Mestre Ford passou todo o seu tempo estudando-a.~ [NWAAR529]
@69 = ~Mas até agora a Pedra da Fonte se recusou a revelar seus segredos. Se quiser saber mais, deve falar com o Mestre Ford.~ [NWAAR533]
@70 = ~Duvido que ajude. Aribeth provavelmente já compartilhou todas as nossas fraquezas com todos os seus generais.~ [NWAAR536]
@71 = ~Certamente você deve sentir, <CHARNAME>? Há uma sombra sobre Neverwinter, uma maldição que diminui a moral e inspira nosso inimigo.~ [NWAAR542]
@72 = ~Depois disso... bem, a lei é clara. Mas a lei também exigiu a morte de Fenthick, e as consequências de sua execução são evidentes para todos.~ [NWAAR557]
@73 = ~A lei é a lei. Aribeth merece a morte.~
@74 = ~A morte dela apenas continuará o ciclo de vingança e derramamento de sangue.~
@75 = ~Em certo nível, meu amor, até compreendo as ações de Aribeth. Eu poderia ter feito o mesmo, se você tivesse sofrido o mesmo destino de Fenthick.~ [NWAAR560]
@76 = ~Não desculpo as ações de Aribeth, mas ver a multidão aplaudindo a execução de seu amante pode muito bem tê-la voltado contra a cidade.~ [NWAAR561]
@77 = ~E agora, na hora mais sombria de Neverwinter, temo que ele tenha sucumbido ao completo desespero. A traição de Aribeth, a culpa pela execução de Fenthick, o massacre de seu povo... às vezes o fardo sobre Lord Nasher é grande demais.~ [NWAAR565]
@78 = ~Ela está trancada na masmorra do castelo. Basta ir para o sul e descer as escadas.~ [NWAAR523]
@79 = ~Receio que Lord Nasher nunca consentiria nisso. Não enquanto estamos sitiados por um exército hostil.~ [NWAAR524]
@80 = ~Se Maugrim fosse morto, talvez isso quebrasse o espírito do inimigo, embora, na verdade, isso também pareça improvável.~ [NWAAR537]
@81 = ~Talvez, de algum modo, o povo de Neverwinter sinta que merece sofrer. Sei que Lord Nasher sente tal culpa, pelo menos. Pelo que aconteceu com Fenthick.~ [NWAAR543]
@82 = ~Lord Nasher seguiu a lei! Ele não tinha escolha!~
@83 = ~Talvez ele possa expiar o que fez.~
@84 = ~Você não pode deixar suas emoções dominarem, <CHARNAME>. Aribeth tem informações detalhadas sobre o inimigo que precisamos.~ [NWAAR548]
@85 = ~Concordo com você, <CHARNAME>... mas não é tão simples assim. Os crimes de Aribeth não podem ser simplesmente ignorados. Agradeça por não sermos nós que devemos decidir seu destino.~ [NWAAR551]
@86 = ~Mas agora não é hora de discutir se as ações de Aribeth foram justificadas. Devemos nos concentrar em encontrar uma maneira de salvar a cidade.~ [NWAAR562]
@87 = ~Pesado é o fardo daquele que usa a coroa, dizem. Pouco podemos fazer por ele, além de tentar salvar a cidade. Precisa de mais alguma coisa, <CHARNAME>?~ [NWAAR566]
@88 = ~Duvido que ajude, de qualquer forma. Ela não confia em nós, ponto final. Talvez por causa das ações de Aribeth, Haedraline tema que todos em Neverwinter sejam corruptíveis.~ [NWAAR525]
@89 = ~Normalmente, as forças de Luskan são apenas covardes e saqueadores. Atacam e fogem. Desta vez, no entanto, algo é diferente. Uma força sinistra impulsiona nossos inimigos.~ [NWAAR538]
@90 = ~E há um peso no ar, uma nuvem escura pairando sobre todos os defensores e os levando ao desespero.~ [NWAAR539]
@91 = ~Não há ninguém que venha em nosso auxílio?~
@92 = ~Reforços da Aliança dos Lordes estão a caminho, mas não sei se conseguiremos resistir até que cheguem.~ [NWAAR540]
@93 = ~Dizer que a lei está sempre certa é uma coisa, <CHARNAME>. Mas há exceções para toda regra.~ [NWAAR544]
@94 = ~Há esperança. Lord Nasher pensará muito antes de executar Aribeth, suspeito. Ele pode até deixá-la viver, se Neverwinter sobreviver a esta invasão.~ [NWAAR547]
@95 = ~Ela merece a morte pelo que fez!~
@96 = ~Lord Nasher foi assombrado pela execução de Fenthick, assim como Aribeth. Talvez, dada uma segunda chance, ele tivesse agido de forma diferente.~ [NWAAR552]
@97 = ~A execução de Fenthick foi legal, mas mesmo ao pronunciar a sentença suspeito que Lord Nasher sabia que a justiça não estava sendo feita.~ [NWAAR545]
@98 = ~A morte de Fenthick nasceu da raiva e da vingança, simples e direto - os mesmos motivos por trás da traição de Aribeth. Lord Nasher sabe bem que colhemos o que plantamos.~ [NWAAR546]
@99 = ~Agora, com Aribeth, ele deve enfrentar não apenas a traição dela, mas os demônios de suas próprias falhas. Mas ele é um bom homem, e no final confio que tomará a decisão sábia.~ [NWAAR553]
@100 = ~Organizar nossas tropas restantes para resistir ao próximo ataque de Luskan requer toda a minha atenção, <CHARNAME>. Se o inimigo romper o Núcleo da Cidade, estaremos perdidos.~ [NWAAR488]
@101 = ~Receio que só possa lhe dedicar alguns momentos, embora tentarei ajudá-lo da melhor forma possível.~ [NWAAR489]
@102 = ~Ah, meu amor - é bom vê-lo novamente. Só gostaria que fosse em circunstâncias menos difíceis.~ [NWAAR487]
@103 = ~É uma honra falar com você. Agora você é um herói de Neverwinter, seu nome ficará para sempre registrado na história da cidade!~
