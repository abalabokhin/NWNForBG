@0 = ~Vejo que Morag estava certa, <CHARNAME> Aribeth não era forte o suficiente para derrotá-lo. Mas ela cumpriu seu propósito.~ [NWMAU056]
@1 = ~Você chegou tarde demais, o ritual acabou, o despertar dos Antigos começou!~ [MAUGR057]
@2 = ~A Raça Criadora será reencarnada e você será o primeiro a provar o poder que minha Rainha me concedeu!~ [MAUGR058]
