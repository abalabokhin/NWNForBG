@0 = ~Você... não deve perturbar... o mestre... Não deve... perturbar... o mestre...~ [NWINTF50]
@1 = ~Acorde dessa! Saia daqui! Não é seguro!~
@2 = ~O que está acontecendo aqui? Você me entende?~
@3 = ~Hã? O-o quê? Sim... eu preciso sair daqui. Eu preciso... ir.~
@4 = ~Você... não deve perturbar... o mestre... Não deve... perturbar... o mestre...~
@5 = ~Minha mente está... está livre. Estamos todos livres, o Devorador está morto! Graças às estrelas e a todos os deuses!~ [NWINTF55]
@6 = ~Eu vou embora. Isso tudo foi demais. Obrigado pela sua ajuda. Obrigado.~
@7 = ~Aqui, seu tolo! Eu essstou aqui dentrrro! HAHAHAHAHAA!!~ [NWINTF51]
@8 = ~Ataque esssta carne se desejar! Não lhe servirá de nada!!~ [NWINTF52]
@9 = ~Desstrua essste corpo e eu encontrareis outro! Não serei enjaulado!~ [NWINTF53]