@0 = ~<CHARNAME>, você foi rápido em atender à convocação. Permita-me ser o primeiro a lhe dar as boas-vindas aos Salões da Justiça.~ [NWFEN100]
@1 = ~Se quisermos ter alguma esperança de encontrar uma cura para a Morte Uivante, precisamos de pessoas como <CHARNAME> a serviço de Neverwinter.~
@2 = ~Sinto-me honrado em servir Neverwinter, Fenthick.~
@3 = ~Só servirei se for bem pago, Fenthick.~
@4 = ~Parece que fui convocado à força. Por que eu deveria me importar com isso?~
@5 = ~Aribeth tem <CHARNAME> na mais alta consideração, Desther. E foi Lorde Nasher quem a colocou no comando, não você. Por favor, <CHARNAME>, perdoe Desther. A praga cobra um preço alto de todos nós, um preço que se tornou ainda maior nas últimas semanas com o ataque à Academia e a perda da cura.~
@6 = ~Eu entendo, Fenthick. São tempos difíceis.~
@7 = ~Ele não tem o direito de falar de mim dessa forma!~
@8 = ~Desther é bom cuidar da língua ou pode acabar perdendo alguns dentes!~
@9 = ~Não há nada de errado em querer ganhar sua fortuna no mundo, Desther. Fique tranquilo, <CHARNAME>, você será bem recompensado por seus esforços. Por favor, <CHARNAME>, perdoe Desther. A praga pesa sobre todos nós, ainda mais após o ataque à Academia e a perda da cura.~
@10 = ~Você fala mais verdade do que imagina, <CHARNAME>. Dentro dos muros da Academia, o verdadeiro horror da Morte Uivante ainda não havia sido sentido. A quarentena de Neverwinter pouco fez para conter a praga. Fogueiras ardem dia e noite enquanto a guarda da cidade se desfaz dos mortos, e ainda assim os corpos se acumulam cada vez mais. Fazemos o possível para conter o caos e manter a ordem nos vários distritos da cidade. Os rumores se espalham rapidamente e os cidadãos estão à beira do pânico.~
@11 = ~Que rumores?~
@12 = ~Você não entende, <CHARNAME>. O verdadeiro horror da Morte Uivante ainda não havia sido sentido dentro dos muros da Academia. A quarentena de Neverwinter pouco fez para conter a praga. Fogueiras ardem dia e noite enquanto a guarda da cidade se desfaz dos mortos, e ainda assim os corpos se acumulam cada vez mais. Fazemos o possível para conter o caos e manter a ordem nos vários distritos da cidade. Os rumores se espalham rapidamente e os cidadãos estão à beira do pânico.~
@13 = ~Como a praga não pode ser curada pelos sacerdotes ou clérigos da cidade, alguns afirmam que ela é algo antinatural, enviada por um inimigo desconhecido determinado a destruir Neverwinter.~
@14 = ~Desther! Não admitirei que você questione a fé do meu verdadeiro amor! Aribeth acreditava que a Academia era um refúgio seguro. De qualquer forma, nem sequer é nosso lugar discutir tais assuntos. Minha Lady Aribeth está no comando, nomeada pelo próprio Lorde Nasher para deter a Morte Uivante. Você deve falar com ela, <CHARNAME>, o mais rápido possível.~
@15 = ~Irei falar com Aribeth imediatamente!~
@16 = ~Quero lhe fazer algumas perguntas.~
@17 = ~Minha Lady Aribeth o aguarda na câmara além das portas ao norte. Lá, ela trabalha incansavelmente para pôr fim à praga que assola Neverwinter. Vá com a bênção de Tyr sobre você.~
@18 = ~É importante que você fale com Aribeth em breve, <CHARNAME>. Mas não recusarei seu pedido. Faça suas perguntas.~
@19 = ~O que você sabe sobre o ataque à Academia?~
@20 = ~Conte-me sobre a praga.~
@21 = ~O que você sabe sobre uma cura para a praga?~
@22 = ~Qual é o seu papel em tudo isso, Fenthick?~
@23 = ~Fale-me sobre Aribeth.~
@24 = ~O que você sabe sobre Desther?~
@25 = ~Não aprendemos muito na semana desde o ataque. Os instrutores foram massacrados, restaram apenas alguns poucos alunos. Receio não haver muito mais que eu possa lhe dizer sobre o ataque. Ainda não descobrimos a identidade dos misteriosos agressores. Talvez Aribeth possa lhe dizer mais.~
@26 = ~Vou indo agora.~
@27 = ~Apesar da quarentena em toda a cidade, a Morte Uivante se espalha rapidamente. Mesmo aqui, no Salão da Justiça, sentimos o toque da praga, como pode ver pelos aflitos ao nosso redor. Desther e eu fazemos o que podemos para confortar essas pobres almas, mas pouco mais podemos fazer. Nem mesmo os sacerdotes mais poderosos de Neverwinter conseguem curar ou ressuscitar aqueles que contraem a Morte Uivante.~
@28 = ~Você não tem medo de contrair a praga também?~
@29 = ~Receio não poder discutir isso com você, <CHARNAME>. Devo obedecer à cadeia de comando, e minha Lady Aribeth é quem está encarregada de encontrar uma cura para a Morte Uivante.~
@30 = ~Faço tudo o que minha Lady Aribeth ordena, <CHARNAME>. O próprio Lorde Nasher a nomeou para supervisionar nossos esforços para encontrar uma cura. Ele não poderia ter feito escolha melhor. Aribeth me colocou no comando de descobrir quem esteve por trás do ataque à Academia. Se você encontrar qualquer informação a respeito, pode reportá-la diretamente a mim.~
@31 = ~Lady Aribeth de Tylmarande é uma paladina que serve a Tyr, assim como eu. Ela é jovem, mas sua fé, coragem e inteligência estão além de qualquer dúvida... assim como sua beleza.~
@32 = ~Você deve perdoar Desther. A pressão da Morte Uivante pesa sobre todos nós. Mas os Helmitas são nossos aliados neste tempo sombrio. Desther e seus seguidores chegaram para oferecer ajuda pouco antes de a cidade ser colocada em quarentena. Vieram nos ajudar quando ninguém mais ousou.~
@33 = ~Vá com a bênção de Tyr sobre você.~
@34 = ~Desther, por favor. Ninguém ainda sabe como a praga se espalha, embora o contato com os infectados não pareça ser o catalisador. Mesmo assim, as pessoas estão queimando os corpos e se trancando em casa por precaução. O povo está com medo. Está à beira do pânico e até de rebelião aberta, e a guarda da cidade luta para manter a ordem.~
@35 = ~Não permitirei que você fale mal da mulher que amo, Desther! Nem deveríamos estar discutindo isso. Aribeth deve decidir quem recebe tais informações; ela é quem está no comando. Precisa de mais alguma coisa, <CHARNAME>?~
@36 = ~E, claro, faço o que posso para aliviar o sofrimento daqueles dentro do Castelo de Never que foram infectados pela Morte Uivante, embora estejam além do meu poder de salvação.~
@37 = ~Aribeth e eu somos de um só coração e alma, é verdade. Mas isso não a torna menos um exemplo de virtude. Ninguém que sirva a Neverwinter é mais capaz do que minha Lady Aribeth. Precisa de mais alguma coisa, <CHARNAME>?~
@38 = ~Olá novamente, <CHARNAME>, e como sempre, seja bem-vindo. Há algo em que eu possa ajudá-lo?~ [NWFEN127]
@39 = ~Gostaria de lhe fazer algumas perguntas, Fenthick.~
@40 = ~Achei que você poderia se interessar por esta nota.~
@41 = ~Veja, consegui pôr as mãos nesta mensagem estranha.~
@42 = ~Talvez lhe interesse dar uma olhada nesta carta anônima.~
@43 = ~Responderei da melhor forma possível, embora haja muitas coisas que apenas Aribeth tem autoridade para discutir.~
@44 = ~O que temos aqui? Hmmm... parece que a praga foi liberada como parte de um plano maior! Talvez enfrentemos provações ainda piores do que a Morte Uivante.~
@45 = ~Por favor, Desther dificilmente acredito que <CHARNAME> seja o tipo de <MANWOMAN> que faria algo assim. Creio que isso mereça uma investigação mais aprofundada, no mínimo.~
@46 = ~Muito bem dito, <SIRMAAM>. <CHARNAME> só tem os melhores interesses de Neverwinter em mente, Desther. Estamos todos do mesmo lado. Fique tranquilo: pretendo seguir todas as pistas para descobrir quem está por trás do sofrimento de Neverwinter. Você fez bem em trazer isso até mim, <CHARNAME>.~
@47 = ~É uma honra servir Neverwinter, Fenthick.~
@48 = ~Existe algum tipo de recompensa por trazer isso à sua atenção?~
@49 = ~Por favor, estamos todos do mesmo lado aqui. Sei que você e Desther não se dão bem, <CHARNAME>, mas isso não é desculpa para lançar acusações infundadas. Desther e seus Helmitas fizeram tanto pela cidade quanto qualquer outro — acusá-lo por antipatia pessoal é mesquinho e não ajuda em nada a situação.~
@50 = ~Fique tranquilo: pretendo seguir todas as pistas para descobrir quem está por trás do sofrimento de Neverwinter. Você fez bem em trazer isso até mim, <CHARNAME>.~
@51 = ~Somos afortunados por ter alguém como você nos ajudando neste assunto, <CHARNAME>. Por favor, aceite estas 500 peças de ouro como recompensa por suas ações.~
@52 = ~Deixe-me ver, <CHARNAME>. Hmmm... “O Povo do Olho”. Um culto em Neverwinter é realmente uma notícia sombria — especialmente um determinado a impedir a recuperação das criaturas de Águas Profundas.~
@53 = ~Desther, acalme-se. Não podemos começar a nos ameaçar por cada insulto percebido. <CHARNAME> estava apenas brincando. E você, <CHARNAME>, não deve fazer tais acusações, nem mesmo em tom de piada. A pena para qualquer um envolvido em prolongar a praga é a morte.~
@54 = ~Suas palavras são sábias, <CHARNAME>. A possibilidade de um culto é algo que devemos considerar com muito cuidado.~
@55 = ~Chega, Desther! Você não tem o direito de fazer tais acusações! <CHARNAME> não fez nada além de nos ajudar nestes tempos difíceis. Por favor, aceite minhas desculpas pelo comportamento de Desther, <CHARNAME>. Todos estamos sob enorme pressão.~
@56 = ~Lorde Nasher me concedeu autoridade para oferecer compensação àqueles que servem à nossa causa. Por trazer esta nota até mim, posso lhe dar 250 peças de ouro.~
@57 = ~Deixe-me ver... hmmm... um traidor em Neverwinter? Alguém que nos traiu na Academia? Isso explicaria muita coisa, <CHARNAME>.~
@58 = ~Desther tem razão, <CHARNAME>. Muitos sabiam que as criaturas de Águas Profundas estavam na Academia. Você não pode simplesmente fazer acusações levianas. O crime de trair Neverwinter é punido com a morte, e não permitirei que isso se transforme numa caça às bruxas! Além disso, Desther e seus Helmitas provaram sua lealdade muitas vezes desde o início da praga.~
@59 = ~Você faz um bom ponto, <CHARNAME>. O ataque à Academia não teria sido tão eficiente se dependesse apenas de rumores.~
@60 = ~Você provou seu valor por meio de suas ações, <CHARNAME>. Aqui estão 200 peças de ouro por seus serviços.~
@61 = ~Saudações, <CHARNAME>. Devo parabenizá-lo por capturar a primeira criatura de Águas Profundas.~ [NWFEN117]
@62 = ~Uma espada não pode ser forjada sem o punho, Desther. A recuperação da primeira criatura é um passo importante para encontrar a cura da Morte Uivante. Com a ajuda de <CHARNAME>, certamente recuperaremos as outras criaturas em breve.~
@63 = ~Chega, Desther. Todos devemos fazer nossa parte para pôr fim a esta praga. Agora, o que posso fazer por você, <CHARNAME>?~
@64 = ~<CHARNAME>! Graças a você, agora recuperamos duas das criaturas de Águas Profundas e estamos a meio caminho da cura da Morte Uivante!~ [NWFEN121]
@65 = ~Já recuperamos duas criaturas, Desther. Isso não lhe dá esperança de que possamos ter sucesso?~
@66 = ~Muito bem, <CHARNAME>. Ouvi dizer que você encontrou a terceira das criaturas de Águas Profundas. A cura está praticamente ao nosso alcance agora!~ [NWFEN124]
@67 = ~Estamos tão perto, Desther. <CHARNAME> não nos decepcionará! A criatura final será nossa se permanecermos fiéis à causa!~
@68 = ~Incrível! Você encontrou todas as criaturas! Minha Lady Aribeth o aguarda no Salão da Justiça. Depressa, precisamos preparar a cura o mais rápido possível.~
@69 = ~Sinto muito, não posso discutir os assuntos de Neverwinter com você. Traga <CHARNAME> até mim, falarei apenas com <HESHE>.~
