@104272 = ~Olá querido, como vai?~ [NWLINAHI]
@104273 = ~Por Sehanine, devo dizer que vai bem!~ [NWLINAYS]
@104274 = ~Em uma jornada, deve haver sempre tempo para descansar.~ [NWLINART]
@104275 = ~Takasi! Oh, desculpe meu élfico.~ [NWLINACS]
