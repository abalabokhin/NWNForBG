// FTOBE2 translation file from BG1

@1 = ~Oooh, a mamãe certamente não vai gostar de você enfiando o nariz aqui! Estranhos na cozinha dela? Ela provavelmente não vai deixar isso passar despercebido.~
@2 = ~Eu não ficaria por aqui se fosse você. Mamãe pode ser um verdadeiro demônio quando é provocada.~
@3 = ~Não sou casada, sabe. Estou apenas procurando o rapaz certo para aparecer.~
@4 = ~Afaste-se de mim!~
