@0 = ~Por que você veio, insignificante criatura? Por qual motivo buscou a caverna de alguém maior do que você? Por que perturba o magnífico Akulatraxas?~ [NWDRA251]
@1 = ~Meu nome é <CHARNAME>. Estou em busca das Palavras de Poder.~
@2 = ~Estou com <CHARNAME>. Estou procurando as Palavras de Poder.~ 
@3 = ~Por favor, poderoso Akulatraxas, busco sua sabedoria para responder às perguntas que tenho.~
@4 = ~Tenho algumas perguntas que você deve responder.~
@5 = ~Entregue-me seu tesouro, verme, ou eu o matarei!~
@6 = ~Vou indo agora.~
@7 = ~Nunca ouvi falar dessas Palavras de Poder, e vivi nestas montanhas toda a minha vida. Continuarei vivendo aqui por muitas mais, aliás, apesar dos esforços dos gigantes das colinas para me desalojar.~
@8 = ~O que foi que você disse sobre os gigantes das colinas?~
@9 = ~Grande Akulatraxas, por que os gigantes das colinas seriam tolos o bastante para desafiar seu poder?~
@10 = ~Você fala com o respeito devido a um dragão. Isso é bom, <RACE>. Conversar é muito mais agradável do que a carnificina que fui forçado a desferir sobre os gigantes das colinas que atacaram meu covil. Agora, o que deseja me perguntar?~
@11 = ~Você é realmente um ser espetacular. Existem outros dragões na região para que eu possa contemplar ainda mais a glória da sua espécie?~ 
@12 = ~Em toda a extensão de seu conhecimento, você sabe algo sobre as Palavras de Poder?~
@13 = ~Caminhe com cuidado, pequeno <RACE> <MALEFEMALE>. Só um tolo ordena sobre um dragão em seu covil. Perdoarei sua falta de etiqueta... desta vez. Caso sua insolência continue, destruirei você como destruí os gigantes das colinas tolos o bastante para me atacar aqui em meu covil! Faça sua pergunta, mas escolha as palavras com cuidado.~
@14 = ~Já terminou de tagarelar, lagarto crescido? Seu hálito fede a cloro.~
@15 = ~Vejo que você precisa aprender uma lição sobre o poder dos dragões, tolo <RACE>! Eu o destruirei como destruí os gigantes das colinas que atacaram meu covil!~
@16 = ~Se tem assuntos em outro lugar, vá cuidar deles. Akulatraxas lhe dá permissão para ir, pequena criatura.~
@17 = ~Seu modo é brusco, <RACE> <MALEFEMALE>. Você deveria mostrar mais respeito ao se dirigir a dragões... Outros da minha espécie podem não ser tão tolerantes com sua falta de etiqueta, mas responderei sua pergunta.~
@18 = ~Os gigantes das colinas tentavam roubar meus ovos! Os covis de muitos da minha espécie foram atacados. Muitos dragões foram mortos e seus ovos levados.~
@19 = ~Existem outros dragões na região, embora nenhum tão magnífico quanto eu. Gorgotha faz seu covil ao norte, na Espinha do Mundo, embora eu saiba pouco sobre ela. Dragões de ouro não gostam muito da minha espécie.~
@20 = ~Uma grande de bronze chamada Scylandara também reside na Espinha do Mundo, outra que tento evitar, pois sente ciúmes de mim. A maioria dos outros fugiu, afugentada pelos mesmos gigantes das colinas que ousaram me atacar aqui em meu covil!~
@21 = ~Mas os gigantes das colinas são como todas as criaturas inferiores: não são páreo para um dragão do meu poder, mesmo em grande número. Os saqueadores não roubarão meus ovos, eu juro isso!~
@22 = ~Esses vilões merecem a morte por ousarem vir atrás de seus descendentes!~
@23 = ~Eu poderia lidar com esses gigantes das colinas por você... por um preço.~
@24 = ~Mas agora tenho a cabeça do chefe dos gigantes das colinas como troféu, e sem seu líder os outros não ousarão mais atacar meus ovos!~
@25 = ~Não posso deixar meu covil. Devo permanecer para proteger meus ovos até que choquem. Mas não descansarei até que os gigantes não existam mais e a cabeça de seu chefe esteja aos meus pés! Eu até estaria disposto a ceder parte do meu vasto tesouro para garantir a vida de meus filhos. Há algo mais que eu possa fazer por você enquanto considera esta oferta, criatura <RACE>?~
@26 = ~Onde posso encontrar o chefe dos gigantes das colinas?~

@28 = ~Negociar com um dragão em seu próprio covil? Você é tão estúpido quanto corajoso... Normalmente eu o mataria por sua insolência, mas estas são circunstâncias incomuns.~
@29 = ~O reduto do chefe dos gigantes das colinas fica no planalto a oeste. Traga-me sua cabeça e você receberá sua recompensa. Agora, meu pequeno instrumento de vingança, há mais alguma coisa?~
@30 = ~**fareja - fareja** Akulatraxas reconhece seu cheiro, pequena criatura. Por que você retornou, insignificante, para perturbar alguém muito maior que você?~ [NWDRA252]
@31 = ~Estou em busca das Palavras de Poder.~
@32 = ~**fareja - fareja** Akulatraxas sente sangue e... algo mais. Algo podre. **FAREJA** Você tem a cabeça do chefe dos gigantes das colinas! Entregue-a para que eu possa ver com meus próprios olhos a prova de sua morte!~ [NWDRA250]
@33 = ~Sinto-me honrado em entregar-lhe a cabeça do gigante, poderoso Akulatraxas.~
@34 = ~Que tipo de recompensa receberei por trazer-lhe esta cabeça?~
@35 = ~Os gigantes das colinas não saquearão mais os covis da minha espécie! Ao matar seu chefe, você ganhou minha gratidão. O favor de um dragão não é dado levianamente. Nós dragões relutamos em ceder nosso tesouro, mas você salvou meus ovos e a vida de meus filhos ainda não chocados da ameaça de futuros ataques. Pegue este ouro, <RACE> <MALEFEMALE>. É uma fortuna pelos padrões mais comuns.~
@36 = ~Agradeço por este presente generoso, poderoso Akulatraxas.~
@37 = ~Grande Akulatraxas, seu tesouro é tão vasto quanto seu poder. Certamente a vida de seus descendentes vale mais do que isso?~
@38 = ~É melhor cavar um pouco mais nesse monte de ouro, Akulatraxas, ou seus ovos podem não estar tão seguros quanto pensa!~
@39 = ~Caminhe com cuidado, criatura <RACE>. Não é sensato expor sua ganância ao falar com um dragão em seu covil, para que eu não pense que planeja roubar meu tesouro. Sua recompensa virá a seu tempo, assim que me entregar a cabeça do chefe!~
@40 = ~Não gosto de sua atitude, dragão. Acho que vou ficar com esta cabeça para mim.~
@41 = ~Você demonstra o respeito que deve ser mostrado aos dragões. Isso é bom, <RACE>.~

@43 = ~Você é ousado, <MALEFEMALE>. Uma criatura mais inteligente aceitaria a oferta do ouro do dragão antes que o dragão mudasse de ideia. Mas gosto de você, <MALEFEMALE>. Você me diverte, como meus últimos pets não fizeram. Por que eu gostaria de um pet sem coleira? Pegue este colar, <RACE>. Sua magia não merece minha atenção, mas pode achá-lo interessante.~
@44 = ~Seu comportamento é desagradável, criatura... mas perdoarei sua natureza grosseira por causa da tarefa que realizou para mim. Pegue este colar como último favor, e que este assunto esteja encerrado. No futuro, sugiro que demonstre mais respeito ao falar com uma criatura muito maior que você.~
@45 = ~Você ousa ameaçar meus filhos, tola criatura <RACE>? Tal crime é imperdoável! Agora você sentirá a ira de Akulatraxas!~
