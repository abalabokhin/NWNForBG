@0 = ~Façam as pazes com seus deuses! Como os Phalorm antes de nós, estamos condenados!~
@1 = ~A Morte Uivante anuncia o fim dos tempos!~
@2 = ~Ai dos que não se arrependem, pois serão abatidos!~
@3 = ~O fim está próximo! Como os arrogantes de Netheril, cairemos em pó!~
@4 = ~A morte é o preço que pagamos por nossa arrogância!~
