@0 = ~Bem-vindo à minha loja! Eu vendo poções aqui. Gostaria de dar uma olhada nos meus produtos?~
@1 = ~Sim, por favor. Mostre-me o que você tem.~
@2 = ~Ah, não, não agora, talvez em outra ocasião.~
@3 = ~Você voltou! Gostaria de dar uma olhada nas minhas poções?~
@4 = ~Sim, acho que sim.~
@5 = ~Talvez em outra hora.~
@6 = ~Tenho certeza de que ficará satisfeito, <SIRMAAM>!~
@7 = ~Espero vê-lo novamente!~