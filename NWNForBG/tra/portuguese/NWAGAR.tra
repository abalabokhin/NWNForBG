@0 = ~Mais carne pro Fosso? Bom! Eu cansado do que tem aqui!~
@1 = ~Heh, Hrusk fraco demais. Você não prova nada vencendo ele. Talvez Fashi te teste, mas ele pequeno também! Ha! Parece briga de crianças!~
@2 = ~Hah! Então você passou por aquele Fashi baixinho? Bah! Eu pisei nele também, uma vez. Agora prove que é durão PRA MIM!~
@3 = ~Você passou pela Terceira Rodada comigo! Você luta bem! Aposto que agora vai tentar Claudus! Cuidado, ele não luta limpo. Não sei como, mas ele não é justo.~
@4 = ~Eu sabia que dava pra fazer, mas eu não sou inteligente o bastante pra isso. BAH! Vou voltar pras batalhas de verdade!~
