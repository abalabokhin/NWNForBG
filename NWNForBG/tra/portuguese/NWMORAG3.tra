@0 = ~Nós somos os mestres, os Criadores, os Antigos. Por muito tempo dormimos, e em nossa ausência as raças inferiores tornaram-se ousadas!~ [NWMORA71]
@1 = ~Os escravos agem como reis, erguendo cidades e nações e reivindicando aquilo que é nosso!~ [NWMORA72]
@2 = ~Haedraline e os Escravos da Palavra nos traíram, abandonando-nos ao exílio dentro da Pedra da Origem.~ [NWMORA73]
@3 = ~O tempo do despertar chegou! Os Criadores erguer-se-ão novamente e libertarão sua vingança sobre o mundo que nos esqueceu!~ [NWMORA74]
@4 = ~Uma tempestade de fogo banirá o inverno interminável! A cidade dos escravos será totalmente consumida pelas chamas do nosso renascimento!~ [NWMORA75]
@5 = ~Os Altos Sacerdotes preparam os rituais finais que libertarão a Pedra da Origem e nos soltarão de nossa prisão! Em breve...~ [NWMORA76]
@6 = ~O que é isto? Os escravos ousaram entrar em nosso reino!~ [NWMORA77]
@7 = ~Matem os de sangue quente! Destruam os escravos!~ [NWMORA70]
