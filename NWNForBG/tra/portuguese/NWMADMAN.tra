@0 = ~Hã, tu acha que ela gosta de mim?~ [NWMAD050]
@1 = ~Posso te fazer umas perguntas?~
@2 = ~Beleza, seu brutamontes, vai lá pro quarto dela.~
@3 = ~Ok, mas rápido, hein? Tenho que ver a mocinha.~
@4 = ~Qual foi o maior orc que tu já viu?~
@5 = ~Quantos litros tem uma galão?~
@6 = ~Qual é teu nome? Não peguei.~
@7 = ~Êh... Então, quanto tempo vivem os dragões?~
@8 = ~Valeu, brigadão.~
@9 = ~Êh... Não sei... Olha, tô com pressa, tá?~
@10 = ~Isso é tudo, vai embora. Só tá perdendo meu tempo.~
@11 = ~Sai daqui. Tô falando com a dama, tá?~ [NWMAD051]
@12 = ~Por que sempre diluem minha cerveja?~ [NWMAD052]
