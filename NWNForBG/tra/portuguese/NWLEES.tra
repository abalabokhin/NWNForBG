@0 = ~Quem é você? Você não é um daqueles soldados de Luskan, né? A Luce disse pra eu ficar longe deles porque eles machucam a gente.~ [NWLEE053]
@1 = ~Você é a Leesa? A irmãzinha da Luce?~
@2 = ~Eu não vou te machucar, garotinha.~
@3 = ~O que você faz por aqui?~
@4 = ~Quero te fazer algumas perguntas.~
@5 = ~Cai fora, pestinha!~
@6 = ~A Luce é minha irmã, mas eu não consigo voltar pra ela; eu tô com muito medo. Eu quero voltar pra Máscara da Pedra da Lua. É lá que a Luce trabalha. Eu sinto falta dela. Tá frio aqui fora e eu fico com medo à noite.~ 
@7 = ~Agora está seguro, Leesa. Você pode voltar pra Máscara da Pedra da Lua.~
@8 = ~Desculpa, garota. Eu não posso te ajudar.~
@9 = ~Eu sou a Leesa. Eu vim pra cá com a Luce. Ela é minha irmã mais velha. Ela é bonita. Tinha um monte de soldados por aqui, então a gente teve que se esconder. A Luce acabou dormindo porque estava escuro. Eu ouvi um barulho e fiquei com medo, aí eu saí correndo. Depois apareceram monstros. Eu quero voltar pra Máscara da Pedra da Lua. É lá que a Luce trabalha. Eu sinto falta dela. Tá frio aqui fora e eu fico com medo à noite.~ 
@10 = ~Eu não sei de nada. Eu tô com frio. Por favor, não me machuca.~
@11 = ~Aaaah!!~
@12 = ~Eu posso? Nossa, obrigada! Você é muito legal, <MANWOMAN>. Mal posso esperar pra ver a Luce de novo!~

@14 = ~Eu não devia confiar em estranhos. A Luce me ensinou isso.~
@15 = ~Eu não sou um estranho. Eu sou <CHARNAME>. Sou amigo da sua irmã, a Luce.~
@16 = ~Ah. Tudo bem, <SIRMAAM>. Você parece bem ocupado. Tem que lutar contra aqueles outros soldados e tudo mais. Se você vir a Luce, diz pra ela vir me buscar, tá?~ 
@17 = ~Acho que se você conhece a Luce, então não é tão ruim assim. Tá bom, eu vou voltar pra Máscara da Pedra da Lua! Você é muito legal, <MANWOMAN>. Mal posso esperar pra ver a Luce de novo!~
@18 = ~Acho melhor eu ficar aqui. Tô com muito medo de sair com toda essa luta acontecendo. Se você vir a Luce, diz pra ela vir me buscar, tá?~ 
@19 = ~Quando eu chegar na Máscara da Pedra da Lua, vou ver a Luce de novo! Eu sinto tanta falta dela.~ [NWLEE051]
@20 = ~Espero que ela não fique brava porque eu fugi. Eu só fiquei com medo. Não queria me perder.~ [NWLEE052]
@21 = ~Aqui dentro é quentinho. Lá fora, nas ruas, tava sempre frio.~ [NWLEE050]
@22 = ~Conseguimos! Conseguimos! Eu vou ficar com a minha irmã Luce!~ [NWLEE054]
