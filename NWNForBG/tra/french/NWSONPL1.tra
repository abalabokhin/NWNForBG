@0 = ~Oui ? Que voulez-vous ? Par chez moi, y veulent pas que j'parle aux aventuriers. Vous êtes un aventurier, hein ?~
@1 = ~Pourrais-je vous poser quelques questions ?~
@2 = ~Oui, je suis un aventurier.~
@3 = ~Qui ? Moi ? Je ne suis pas un aventurier.~
@4 = ~Au revoir.~
@5 = ~Hum... je pense pouvoir répondre à une de vos questions. Que voulez-vous savoir ? Eh ! Est-ce au sujet d'Urth ? Je ne veux pas lui faire avoir des ennuis.~
@6 = ~J'ai juste besoin qu'on m'indique mon chemin.~
@7 = ~J'aimerais avoir quelques informations sur Port Llast.~
@8 = ~Urth ? Qui est-ce ?~
@9 = ~Connaissez-vous un peu les environs ?~/*Vous savez quelque chose de ces zombis ?*/
@10 = ~Ah ! Que vouliez-vous me demander ?~
@11 = ~Ces jours-ci, y'a beaucoup d'aventuriers à Port Llast. P'pa dit qu'ils viennent tous de Padhiver, parce qu'ils veulent vivre ici. Oui, je veux partir à l'aventure mais mon papa il dit que c'est une perte de temps. Hum, sans vouloir vous offenser, <SIRMAAM>.~ 
@12 = ~Ton papa n'apprécie pas les aventuriers ?~
@13 = ~Je ne sais pas. Il dit qu'il faut pas leur parler. Je crois que c'est parce qu'on est des fermiers. Il aime pas se battre.~
@14 = ~Urth est mon ami. Il habite avec sa famille dans une maison à l'ouest de la ville, celle des Eisenfeldt. Mais... je ne sais pas. Il est bizarre, ces derniers temps. Je ne devrais pas en dire davantage.~/*Salutations, mon ami. Urth est mon ami. Il vit à la ferme Eisenfeldt. Mais... c'est bizarre. Il est étrange ces derniers temps. Je ne devrais pas en dire plus.*/
@15 = ~Qui sont les Eisenfeldt ? Où vivent-ils ?~
@16 = ~En fait, j'aimerais vous poser d'autres questions.~
@17 = ~Je ne sais pas. Je ne le vois plus beaucoup. L'autre jour je l'ai aperçu et il s'est enfui. Il me fiche la frousse maintenant. On peut parler d'autre chose ? Z'avez d'autres questions ?~ 
@18 = ~P'pa dit que je devrais pas parler des gens dans leur dos. Je ne devrais rien dire de plus. On peut parler d'autre chose ? Z'avez d'autres questions ?~
@19 = ~Au revoir, l'étranger. Vous êtes plutôt sympathique, finalement, <SIRMAAM>.~/*Salut étranger. En fin de compte, vous êtes gentil, <SIRMAAM>.*/
@20 = ~Pas de problème. Où voulez-vous aller ? J'ai passé toute ma vie ici, et je sais tout ce qu'il y a à savoir.~
@21 = ~Y-a-t-il une auberge dans le coin ?~
@22 = ~Y-a-t-il un temple en ville ?~
@23 = ~J'ai besoin d'acheter de l'équipement.~
@24 = ~Y-a-t-il des rôdeurs ou des druides en ville ?~
@25 = ~Oui. Vous devriez aller à l'Auberge de l'Alliance, au sud de la ville, près des quais. Il y a plein de gens comme vous, là-bas. Autre chose ?~/*Ouais. Je pense que le mieux pour vous est d'aller à l'Auberge de l'Alliance, à la porte nord de la ville. Il y a plein de gens comme vous là-bas. Autre chose ?*/
@26 = ~Oui, Neurik dirige le temple et veille sur nous tous, autant qu'il le peut. Le temple donne sur la place de la ville.~/*Ouais, Neurik dirige le Temple de Tyr et s'occupe de nous tous... enfin, il fait ce qu'il peut. Le temple est à la porte nord.*/
@27 = ~Vous pouvez acheter des épées et tout le reste à l'Enclume Fendue, au centre de la ville. Mais papa dit que c'est de l'argent gaspillé. Sans vous offenser, <SIRMAAM>.~/*Vous pourrez acheter des épées et tout ce qu'il vous faut à l'Enclume Fendue, c'est à l'ouest de la ville. Mais p'pa dit que c'est jeter son argent par les fenêtres. Sans vouloir vous offenser, <SIRMAAM>.*/
@28 = ~Oui, il y en a un au nord-est de la ville. Vous pourriez sûrement lui parler si vous vouliez. Une porte dans le rempart mène au bosquet, mais c'est un secret.~/*Ouaip, y'en a un au nord-est de la ville, dans un bosquet. Vous pourrez certainement lui parler si vous voulez. Contrairement aux apparences, vous n'êtes pas une simple statue, n'est-ce pas...*/
@29 = ~Hum... Je ne sais pas vraiment quoi vous dire... la plupart des gens vont voir Neurik quand ils veulent savoir quelque chose sur la région. Il se trouve au temple de Tyr.~
@30 = ~Hum... vous voulez dire, au-delà des fermes et tout ça ? P'pa me laisse pas aller très loin. Il dit qu'il y a des bandits et d'autres choses comme ça hors de la ville. Bien entendu, Shaldrissa les admire tous. Pourriez demander aux gars des baraquements. Ils n'arrêtent pas d'aller et venir, et y connaissent ce genre de choses. C'est juste au sud du temple de Tyr.~ 
@31 = ~Shaldrissa ? Qui est-ce ?~
@32 = ~Quelqu'un d'autre pourrait-il m'aider ? Quelqu'un du coin, peut-être ?~
@33 = ~Oh ! C'est juste une fille. C'est la fille du bourgmestre, et elle arrête pas de dire qu'elle veut quitter la ville. Je pense aussi que ça serait amusant de partir à l'aventure, mais elle arrête pas d'en parler et elle fait rien. Mon papa, il dit qu'elle est pas très nette dans sa tête.~ 
@34 = ~J'aurais pas dû dire ça. Je voulais rien dire par là. Mon papa il dit qu'il faut jamais dire du mal des gens dans leur dos. Désolé.~
@35 = ~Euh... vous pourriez peut-être parler à Neurik. Il est au temple et il sait des tas de choses. Il pourra peut-être vous aider.~/*Hum... vous pourriez peut-être aller parler à Neurik. Il est au Temple de Tyr, et il sait pas mal de choses. Peut-être qu'il pourra vous aider.*/
@36 = ~Ah, vous revoilà ? Vous voulez sûrement me poser une question. Je sais beaucoup de choses.~/*Mouais, ça me paraît bon. Je voudrais vous demander autre chose sur Boisroussi.*/
@37 = ~Je voulais simplement vous voir. Au revoir.~/*Je veux simplement discuter. Au revoir.*/
@38 = ~Vraiment ? Il allait... il allait bien ?~
@39 = ~Tu n'as pas pu le rattraper ? Tu as toujours été le plus rapide.~
