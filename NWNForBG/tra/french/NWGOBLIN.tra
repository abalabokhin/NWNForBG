@0 = ~Nous arrêter ! Pas taper ! Nous pas vouloir mourir !~
@1 = ~Maintenant, répondez à mes questions.~ /*"Répondez à mes questions..."*/
@2 = ~J'accepte votre reddition, mais seulement si les autres gobelins cessent de me combattre.~
@3 = ~Je vous écoute. Qu'est-ce que j'y gagne si je vous laisse vivre ?~ /*Je vous écoute. Quoi vous donner si moi laisser vous vivre ?*/
@4 = ~En fait, j'adore casser du gobelin. Assez discuté.~
@5 = ~D'accord, vous vivrez... pour l'instant.~ /*D'accord, moi y aller.*/
@6 = ~Vous poser questions gobelins ? Nous pas savoir beaucoup comme <RACE> croire nous savoir. Euh, question être quoi ?~
@7 = ~Parlez-moi de ces cavernes.~
@8 = ~Où est votre chef ? Je veux lui parler.~ /*De quel endroit parlez-vous ? J'aimerais te parler.*/
@9 = ~[Réussite] Vous vouloir tous gobelins faire paix avec vous ? D'accord, nous pouvoir faire ça, nous dire à tous. Vous laisser nous, oui ?~
@10 = ~D'accord.~
@11 = ~Vous vouloir quoi ? Vous vouloir trésor ? Moi avoir or. Moi donner or si vous arrêter combattre nous.~
@12 = ~Les autres gobelins cesseront de se battre si j'accepte ?~ /*Quel est le sens de tous ces combats ?*/
@13 = ~Aaarrrggghhh ! Nous encore combattre les <RACE> ! Tuer !~/*Aaarrrggghhh ! Nous continuer combattre <RACE>. A mort !*/
@14 = ~Nous vivants ! Nous encore respirer ! Nous partir maintenant !~
@15 = ~Nous être en guerre contre orques et gobelours. Avant nous vivre seuls ici, maintenant avoir autres vivre avec nous. A cause du maître.~
@16 = ~Vous vouloir parler à chef de nous, hein ? D'accord, moi vous dire. Lui juste ici.~ /*Vous vouloir parler avec chef gobelins, hein ? D'accord, moi dire où lui être. Lui derrière cette porte.*/
@17 = ~Nous vivants ! Nous encore respirer ! Nous partir maintenant ! Et nous dire autres gobelins pas combattre vous ! Nous gentils, vous voir !~
@18 = ~Nous pas devoir combattre contre vous. Moi pas avoir droit parler vous. Vous parler chef.~
@19 = ~Moi pas tuer vous maintenant, ami <RACE>. Parler au chef.~
/*Moi pas tuer ami du peuple <RACE>. Toi parler à chef.*/