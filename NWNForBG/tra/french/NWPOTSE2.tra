@0 = ~Bienvenue dans ma boutique ! Je vends des potions. Voulez-vous jeter un coup d'oeil à mes marchandises ?~/*Bienvenue à vous. J'ai fini. Cela vous dirait d'acheter un esclave ?*/
@1 = ~Oui, s'il vous plaît. Montrez-moi ce que vous avez.~/*"Oui, s'il vous plaît." Montrez-moi ce que vous savez faire...*/
@2 = ~Oh, non, non. Une autre fois.~/*D'ac, une autre fois.*/
@3 = ~Vous êtes de retour ! Voulez-vous jeter un coup d'oeil à mes potions ?~/*C'est vous ! J'aimerais jeter un oeil à vos marchandises.*/
@4 = ~Ouais, pourquoi pas.~/*Oui, je pense.*/
@5 = ~Une autre fois, peut-être.~
@6 = ~Je suis sûr que vous y trouverez votre bonheur, <SIRMAAM> !~/*J'y répondrai de mon mieux, <SIRMAAM>.*/
@7 = ~Au plaisir de vous revoir !~
/*Hah ! Je rajeunis !*/