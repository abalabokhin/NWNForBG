@0 = ~Pardon, monsieur, je n'ai pas le temps de bavarder.~ /*Navré mais je n'ai pas le temps pour l'instant.*/
@1 = ~C'est un plaisir de voir des personnes de qualité dans notre ville. Bienvenue à Port Llast !~
@2 = ~Oh, des aventuriers ! Il y en a bien trop à Port Llast.~ /*aventurier Il y a des loups-garous à Port Llast ?*/
@3 = ~Ne me dérangez pas, je n'ai pas le temps de bavarder.~ /*Navré mais je n'ai pas le temps pour l'instant.*/
@4 = ~On dit que tous les habitants de Padhiver sont morts !~ /*Moi dire maître à vous mort.*/
@5 = ~Vous venez de Padhiver ? Ne m'approchez pas, vous êtes contagieux.~ /*Vous êtes de Padhiver? Vous avez contracté le fléau?*/
@6 = ~Va te laver, fiston. Tu es imprégné de l'odeur de la mer.~
