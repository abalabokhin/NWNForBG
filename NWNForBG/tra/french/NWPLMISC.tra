@0 = ~Bienvenue ! On dirait que vous venez de loin.~/*Bienvenue ! On dirait qu'il y a des méchants droit devant.*/
@1 = ~C'est vrai. Pouvez-vous me dire où se trouve l'auberge la plus proche ?~/*C'est vous ! Pourrais-tu me dire pourquoi Desther fait tout ceci ?*/
@2 = ~Oui, et j'aimerais voir vos marchandises.~/*J'aimerais voir les articles que vous proposez.*/
@3 = ~Je n'ai pas la moindre envie de vous parler.~/*Je ne veux pas vous parler.*/
@4 = ~Bien sûr ! Cherchez le plus vieux bâtiment au centre de la ville. Il a été construit il y a très longtemps et, aussi loin que je me souvienne, il a toujours été là.~/*Certainement. Cherchez ce qui est dissimulé. Il possède une tour quelque part vers Boisroussi mais je n'y suis jamais allé.*/
@5 = ~Merci. Mais avant de partir, j'aimerais jeter un coup d'oeil à vos marchandises.~/*Merci. J'aimerais jeter un oeil à vos marchandises.*/
@6 = ~Merci. Je dois partir.~
@7 = ~Voilà ce que j'aime.~/*J'adore ça !*/
@8 = ~Oh, vous êtes de retour ! Voulez-vous jeter un coup d'oeil à mes marchandises ?~/*Bon vent. Cette Main momifiée vous intéresserait-elle ?*/
@9 = ~Oui, voyons ce que vous avez.~/*Oui, montrez-moi ce que vous avez.*/
@10 = ~Non, pas maintenant.~
@11 = ~Mais n'oubliez pas de revenir quand vous aurez besoin de quelque chose !~
/*Revenez si vous avez besoin de quelque chose.*/