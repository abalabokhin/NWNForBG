@104302 = ~Un visage amical est une bénédiction, par les temps qui courent.~ [NWYESL36]/*Aarin dire moi que vous colère tout le temps.*/
@104303 = ~Tout ce qu’il vous faut.~ [NWYESL18]/*Que vous faut-il ?*/
