@104272 = ~Bonjour, comment allez-vous ?~ [NWLINAHI]
@104273 = ~Par Sehanine, plutôt, oui !~ [NWLINAYS]
@104274 = ~Lors d'un voyage, il faut toujours procéder par étapes.~ [NWLINART]
@104275 = ~Sapristi ! Oh, excusez-moi !~ [NWLINACS]
@104276 = ~La Déesse vous emmène !~ [NWLINAB1]
@104277 = ~Au nom de Sehanine Lunarc !~ [NWLINAB2]
@104278 = ~La victoire est à nous !~ [NWLINAB3]
