@0 = ~Hein ? Hé, vous ! Vous essayez de mettre la main dans ma poche ?~/*Hmm ? Hé hé hé ! Essayez-vous de me tendre un piège ?*/
@1 = ~\[Intelligence\] - Vos accusations sans fondement me scandalisent. Je ne me trouvais même pas près de vous, et j'ai tout un groupe de témoins qui le confirmeront.~/*Je pense avoir retrouvé l'un de vos druides. On m'a engagé pour récupérer la gemme et je compte bien l'obtenir. Donnez-la-moi !*/
@2 = ~\[Sagesse\] - Réfléchissez un peu avant de lancer des accusations aussi gratuites. J'étais pressé et je vous ai probablement bousculé en passant. Personne n'a été blessé.~/*Qui êtes-vous ? Et que faites-vous dans les rues ? Je ne comprends pas ce que vous dites. Non, pas vraiment.*/
@3 = ~\[Charisme\] - Je vous assure que je n'ai rien fait. En revanche, j'ai aperçu une silhouette encapuchonnée qui passait par là. Ce ne serait pas plutôt le véritable coupable ?~/*Mais bien sûr vous pas le faire. Mais je le dois ! J'ai besoin de cet anneau. Je peux avoir cette pièce, s'il vous plaît ?*/
@4 = ~\[Connaissances\] - Au contraire. J'étais fasciné par cet objet tombé de votre poche et je voulais simplement l'examiner de plus près avant de vous le rendre.~/*[Se concentrer sur les chasseurs.] "Mais pour l'instant, je te souhaite plein de chance. Je vais me reprendre une bière avant de descendre."*/
@5 = ~\[Réputation\] - Hum, permettez-moi de vous rappeler que vous vous adressez à un citoyen honorable. Votre bourse pendait à votre ceinture et allait tomber. Je voulais simplement la remettre correctement et vous prévenir.~/*Le rat vous renifle et décide que vous n'êtes pas encore un cadavre." Vous vouloir guérir pour reprendre concours. Je voulais simplement vous l'entendre dire.*/
@6 = ~\[Réputation\] - Vous devriez peut-être éviter de me mettre en colère, non ? Fermez-la et partez d'ici tant que vous le pouvez encore.~/*Et si vous demander à magiciens, hein ? Fermez-la et restez tranquille ou je vous tue !*/
@7 = ~(Tenter de s'enfuir.)~/*Bon vent.*/
@8 = ~Quelle insolence ! Encore une fois, vous essayez de me voler.~/*Qu'est-ce qui est parti ? Vous essayez de me rouler !*/
@9 = ~C'en est trop ! Je ne me laisserai pas dépouiller par des gens comme vous !~/*C'est bien trop facile ! J'aimerais vous soumettre une hypothèse.*/
@10 = ~Hum... Cette fois, vous vous en tirerez avec un simple avertissement. Cette fois...~/*Haaa... "Parlez-moi de cet anneau." Par ici.*/
@11 = ~Mais à partir de maintenant, je vais vous surveiller de beaucoup plus près !~/*Ouais, mais je vous ai à l'oeil.*/
@12 = ~Bah ! Je fermerai les yeux cette fois, mais ne recommencez pas !~/*Ah ! Je vais vous sauver, mais ne traînez pas dans mes pattes.*/
@13 = ~Très bien ! Mais souvenez-vous-en : c'est votre dernier avertissement !~/*Grandes haches Portez-vous bien, jusqu'à notre prochaine rencontre.*/
@14 = ~Courez où vous voulez, voleur ! Mais tout le monde connaîtra bientôt ce sale larcin !~/*Courrez tant que vous le pouvez ! Je ne perdrai pas cette bataille !*/
@15 = ~Ça suffit ! Plus d'excuses !~/*Quoi encore ? Assez. Vous mourir !*/
@16 = ~Cette fois, je vais signaler cette tentative de vol éhontée ! Maintenant, hors de ma vue !~/*"Ce casque me protégera." A couvert !*/
@17 = ~Encore une fois, hein, voleur ? Vous ne l'aurez pas ! Il faut mettre fin à ces pitoyables tentatives de vol.~
/*Encore vous ? Vous n'avez pas le droit ! J'ai besoin de votre aide. Il faut arrêter Heurodis.*/