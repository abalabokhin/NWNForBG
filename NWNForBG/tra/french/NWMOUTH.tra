@0 = ~Vous ne pouvez pas passer.~/*T'es pas si fort !*/
@1 = ~Pourquoi ?~
@2 = ~Nous n'avons pas fait tout ce chemin pour nous laisser arrêter par une porte qui parle.~/*Pourquoi ne pas avoir dit tout ça la première fois que nous avons parlé ?*/
@3 = ~Qui êtes-vous ?~
@4 = ~Seuls ceux qui possèdent les quatre objets de cristal peuvent franchir cette porte.~/*Non, il se fait tard. Restons-en là.*/
@5 = ~Quoi ? C'est ridicule.~/*Quoi ? "C'est ridicule."*/
@6 = ~J'en ai assez de ces énigmes. Ouvrez, ou vous finirez en tas de gravats bavards.~/*Je veux parler des Ménestrels. Ne devriez-vous pas avoir honte de travailler ici ?*/
@7 = ~J'abandonne. Je ne veux plus entendre parler de ces énigmes. Ramenez-moi à la taverne.~/*J'aime . Je n'ai pas d'autres questions. "Alors nous y revoilà ?"*/
@8 = ~D'accord. A r'voir.~ 
@9 = ~Vous êtes sûr ? Vous ne pourrez pas revenir, vous ne pourrez pas revenir.~/*Avez-vous été blessé ? Vous vouloir moi remonter vous en haut ?*/
@10 = ~Rappelez-nous qui vous comptez laisser passer ?~/*Rappelez-moi comment la trouver.*/
@11 = ~C'est décidé, je retourne à la taverne.~ /*est retombé dans le tunnel.*/
@12 = ~Je ne faisais que passer. À plus tard.~ /*Je plaisantais, c'est tout. A plus tard.*/
@13 = ~Qu'il en soit ainsi.~ /*"Très bien."*/
@14 = ~Vous pouvez passer.~ 
/*Vous pouvez passer.*/