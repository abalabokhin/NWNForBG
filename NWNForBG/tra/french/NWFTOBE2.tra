// FTOBE2 translation file from BG1
@1 = ~Ah ! De quel droit entrez-vous chez moi ?!~/*Ah ! Et quel genre de pétrin, exactement ?*/
@2 = ~Pardonnez mon intrusion, je me demandais simplement ce que vous faisiez.~/*Je suis désolé pour vous, mais j'ai donné la bonne réponse.*/
@3 = ~Gardez votre salive, je ne vous veux aucun mal.~/*Calmez-vous. Je ne vous veux aucun mal.*/
@4 = ~Par le droit du plus fort ! Je vous conseille de coopérer pendant que je me sers parmi vos objets de valeur.~/*A couvert ! Je serais honoré de prêter ma lame à votre cause.*/
@5 = ~Toutes mes excuses ! Je dois m'être trompé d'adresse. Je pars immédiatement.~/*Archéologue Je dois avertir les autres ! Il me faut tout de suite un guérisseur.*/
@6 = ~Ce que je fais ne vous regarde pas ! Partez sur-le-champ, ou j'appelle les gardes !~/*Quoi moi faire pas regarder vous. Soigner ! J'suis beaucoup blessé !*/
@7 = ~Alors laissez-moi tranquille, moi et les miens ! Personne ne vous a invité chez moi, alors dehors !~/*Laissez-moi tranquille ! Vous n'êtes pas invité. Sortez !*/
@8 = ~Je ne peux rien faire pour vous arrêter, mais je peux appeler ceux qui le peuvent. Partez maintenant, avant que la garde ne vous règle votre compte.~/*Je ne peux pas vous le prendre. Tenez, voici les bois. Alors vous donner moi et moi partir.*/
@9 = ~Et vous faites bien ! Si mon mari vous surprenait ici, il vous ferait sûrement la peau !~/*Comme il se doit. Si j'avais su que vous viendriez, j'aurais fermé la porte à clef !*/
@10 = ~Je ne suis qu'une simple fille de la ville, et je doute que ce que je sais puisse être utile à de puissants aventuriers.~/*Je suis certain que rien de ce que vous estimez "intéressant" ne me concerne.*/
@11 = ~Je vous l'ai déjà dit. Je ne veux pas de vous ici ! Maintenant, fichez le camp !~/*Je vous aiderai à trouver ce traité. Je ne veux pas mourir. Ne bougez plus !*/
@12 = ~Vous avez assez abusé de mon hospitalité !~
/*De rien.*/